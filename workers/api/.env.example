# ── Stemfer Worker — Secrets ───────────────────────────────────────────────
# Set each one with: wrangler secret put <NAME>
# Never commit real values to git.

JWT_SECRET=your-super-secret-jwt-key-min-32-chars
PAYSTACK_SECRET_KEY=sk_live_...
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Resend (transactional email) ─────────────────────────────────────────────
# Stemfer sends transfer notification emails via the Resend API.
# Emails are sent from: noreply@stemfer.com (must be a verified domain in Resend)
#
# One-time setup:
# 1. Sign up at resend.com and add/verify the stemfer.com domain
# 2. Create an API key in the Resend dashboard
# 3. Set the secret: wrangler secret put RESEND_API_KEY
#
RESEND_API_KEY=re_...
